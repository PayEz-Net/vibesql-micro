{
  "name": "vibesql-micro",
  "version": "2.0.0",
  "description": "PostgreSQL that feels like SQLite — embedded PostgreSQL 16.1 in a single binary. JSONB, zero config, pinned-port `serve` mode. Thin npm wrapper: the native binary is downloaded from the matching GitHub Release on postinstall.",
  "license": "Apache-2.0",
  "homepage": "https://vibesql.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PayEz-Net/vibesql-micro.git"
  },
  "bugs": {
    "url": "https://github.com/PayEz-Net/vibesql-micro/issues"
  },
  "keywords": [
    "database",
    "sql",
    "postgresql",
    "postgres",
    "jsonb",
    "embedded",
    "zero-config",
    "vibesql",
    "vibesql-micro"
  ],
  "bin": {
    "vibesql-micro": "./bin/vibesql-micro"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "install.js",
    "bin/vibesql-micro",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
